<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/playerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/playerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@color/card">

            <Button
                android:id="@+id/playerBackBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_card"
                android:text="◀"
                android:textColor="@color/txt"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Link paste karo aur Play dabao"
                android:textColor="@color/txt"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <Button
                android:id="@+id/playerSettingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_card"
                android:text="⚙"
                android:textColor="@color/txt"
                android:textSize="14sp" />
            <Button
                android:id="@+id/playerFsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_card"
                android:text="⛶"
                android:textColor="@color/txt"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Player frame -->
        <FrameLayout
            android:id="@+id/playerFrame"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#000000">

            <FrameLayout
                android:id="@+id/overlayHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- URL input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/playerUrlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="YouTube link…"
                android:textColor="@color/txt"
                android:textColorHint="#5B6A94"
                android:textSize="14sp" />

            <Button
                android:id="@+id/playerGoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn"
                android:text="▶"
                android:textColor="#04070F"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Meta section (title/channel/pills) -->
        <include layout="@layout/player_meta" />

        <!-- Quality pills -->
        <HorizontalScrollView
            android:id="@+id/playerQPillsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/playerQPills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Download row -->
        <LinearLayout
            android:id="@+id/playerDlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/playerDlVideoBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn"
                android:text="⬇ Video"
                android:textColor="#04070F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/playerDlAudioBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn"
                android:text="🎵 Audio"
                android:textColor="#04070F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/playerCancelDl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:text="✕"
                android:textColor="@color/txt"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Related/UpNext -->
        <TextView
            android:id="@+id/playerQueueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Up Next"
            android:textColor="@color/txt"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playerQueueList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone" />

        <!-- Search -->
        <TextView
            android:id="@+id/playerSearchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search results"
            android:textColor="@color/txt"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/playerSearchList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
