<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/uThumb"
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:background="#000000"
        android:contentDescription="thumbnail"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/uTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Video title"
            android:textColor="@color/txt"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/uMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/mut"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="▶"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Recent row ka per-item close (✕): sirf Recent list me dikhta hai,
         Up Next me hidden rehta hai. Tap = wahi item history se hatao. -->
    <ImageButton
        android:id="@+id/uClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="gone" />
</LinearLayout>
