<?xml version="1.0" encoding="utf-8"?><!-- v3.1 YouTube-style meta section (NEW, additive).
     activity_player.xml me <include> se judta hai (player ke theek niche):
     expandable description, channel row, action pills, comments preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/metaRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Expandable description -->
    <TextView
        android:id="@+id/metaDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="10dp"
        android:text="Description..."
        android:textColor="@color/txt"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Channel row: avatar + name/subs + Subscribe -->
    <LinearLayout
        android:id="@+id/metaChannelRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/metaAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#000000"
            android:contentDescription="Channel avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/metaChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Channel"
                android:textColor="@color/txt"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/metaSubs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/mut"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/metaSubBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn"
            android:minWidth="0dp"
            android:text="Subscribe"
            android:textColor="#04070F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action pills: Like / Dislike / Share / Download -->
    <LinearLayout
        android:id="@+id/metaPillsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/metaLike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:minWidth="0dp"
            android:text="👍"
            android:textColor="@color/txt"
            android:textSize="12sp" />

        <Button
            android:id="@+id/metaDislike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:minWidth="0dp"
            android:text="👎"
            android:textColor="@color/txt"
            android:textSize="12sp" />

        <Button
            android:id="@+id/metaShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:minWidth="0dp"
            android:text="📤 Share"
            android:textColor="@color/txt"
            android:textSize="12sp" />

        <Button
            android:id="@+id/metaDl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:minWidth="0dp"
            android:text="⬇ Save"
            android:textColor="@color/txt"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Comments preview card -->
    <LinearLayout
        android:id="@+id/metaCommentsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/metaCommentsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comments"
            android:textColor="@color/txt"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/metaCommentsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
