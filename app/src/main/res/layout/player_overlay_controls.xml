<?xml version="1.0" encoding="utf-8"?><!-- YouTube-style in-video controls overlay (NEW, additive).
     PlayerOverlay.kt isko playerFrame me inflate karta hai.
     Tap = show/hide (3s auto-hide), double-tap L/R = +-10s. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ovRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Top bar: minimize | autoplay | CC | settings gear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/ovMin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ovAutoplay"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Autoplay ON"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ovCc"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="CC"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ovGear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_dim"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙️"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Center: Rewind 10s | Play/Pause | Forward 10s -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ovRew"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle_dim"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⏪"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/ovPlay"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/circle_dim"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/ovFwd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle_dim"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⏩"
            android:textSize="30sp" />
    </LinearLayout>

    <!-- Double-tap seek flash (center, auto-hide) -->
    <TextView
        android:id="@+id/ovFlash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="110dp"
        android:background="#CC000000"
        android:padding="10dp"
        android:text="↶ 10 seconds"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom: time + sleek seekbar + fullscreen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ovCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/ovSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/player_seekbar"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/ovDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ovFs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⛶ Fullscreen"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
